# mobile's dependency tree has a real (if overly strict) peer-range conflict between
# react-native-reanimated and react-native-worklets — discovered during the Expo SDK 54
# downgrade (see README's "Mobile app — SDK 54 downgrade" section). --legacy-peer-deps is a
# routine, low-risk practice in the RN/Expo ecosystem, whose peer-dependency hygiene lags
# real compatibility. Setting it here (rather than remembering to pass the flag by hand every
# time) means a fresh clone, CI, and every local `npm install`/`npm ci` all behave identically —
# without it, CI's first `npm ci` would fail with the exact ERESOLVE error this session hit.
legacy-peer-deps=true
