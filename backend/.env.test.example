NODE_ENV=test
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
# A dedicated database, isolated from the dev DB (`dineflow`) — global-setup.js creates this
# and migrates it fresh on every e2e run. Deliberately not named "dineflow": global-setup.js
# hard-refuses to run at all if this ever resolves to the real dev database.
DB_DATABASE=dineflow_test

CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=e2e-test-only-access-secret-not-for-real-use
JWT_ACCESS_EXPIRES_IN=15m
PAYMENT_GATEWAY_KEY_ID=mock_key_id_test
PAYMENT_GATEWAY_SECRET=e2e-test-only-payment-secret
PAYMENT_WEBHOOK_SECRET=e2e-test-only-webhook-secret

# Copy this file to .env.test (gitignored) to run `npm run test:e2e -w backend` locally.
# CI (.github/workflows/ci.yml) doesn't use this file at all — it sets the equivalent values
# directly as job env vars (matching its own Postgres service container's credentials), since
# .env.test is gitignored and won't exist on a fresh CI checkout. env-setup.js's dotenv.config()
# call silently no-ops when the file is missing, so both paths reach global-setup.js the same way.
