PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=dineflow

# Off by default (local Postgres has no TLS listener). Set DB_SSL=true for most managed
# production Postgres providers; DB_SSL_REJECT_UNAUTHORIZED=false only if that provider issues a
# certificate this app can't otherwise verify (check their docs before disabling verification).
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# comma-separated list of allowed origins for CORS — REQUIRED in production (the app refuses to
# start without it rather than falling back to a permissive default); optional in dev, where it
# falls back to the frontend's own default port (http://localhost:3000).
CORS_ORIGIN=http://localhost:3000

# generate real secrets for anything beyond local dev, e.g.: openssl rand -hex 64
# In production, the app refuses to start if this (or PAYMENT_GATEWAY_SECRET /
# PAYMENT_WEBHOOK_SECRET below) is missing, under 32 characters, or still looks like this
# checked-in placeholder — see common/utils/production-safety.util.ts.
JWT_ACCESS_SECRET=dev-only-change-me-access
JWT_ACCESS_EXPIRES_IN=15m

# used only by `npm run seed:admin` to bootstrap the first ADMIN user
ADMIN_EMAIL=admin@dineflow.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Platform Admin

# Mock payment gateway -- active whenever RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET below are unset.
# PAYMENT_GATEWAY_SECRET/PAYMENT_WEBHOOK_SECRET are only used by the mock's own simulated
# checkout+webhook (mock-complete / mock-send) -- delete nothing, just leave the RAZORPAY_* vars
# unset for the mock to stay active.
PAYMENT_GATEWAY_KEY_ID=mock_key_id_dev
PAYMENT_GATEWAY_SECRET=dev-only-change-me-payment-secret

# A real gateway issues this separately from PAYMENT_GATEWAY_SECRET above — the
# checkout-verification secret and the webhook secret are two different channels,
# and a leak of one shouldn't compromise the other.
PAYMENT_WEBHOOK_SECRET=dev-only-change-me-webhook-secret

# Real Razorpay -- set both to switch PaymentsModule/RefundsModule from the mock to
# RazorpayPaymentGateway (gateways/razorpay-payment.gateway.ts). Get these from the Razorpay
# Dashboard (Settings -> API Keys) -- test-mode keys (rzp_test_...) work identically to live ones
# for everything this app does with them.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# The secret configured against the webhook URL in Razorpay Dashboard -> Settings -> Webhooks
# (point it at https://<your-backend>/api/v1/webhooks/razorpay, events: payment.captured and
# payment.failed at minimum) -- deliberately separate from PAYMENT_GATEWAY_SECRET/
# PAYMENT_WEBHOOK_SECRET above, which only the mock's simulated webhook uses.
# RAZORPAY_WEBHOOK_SECRET=

# RazorpayX Payouts -- set alongside the two RAZORPAY_KEY_* above to switch PayoutsModule from the
# mock to RazorpayXPayoutGateway (gateways/razorpayx-payout.gateway.ts). This is the platform's own
# RazorpayX current/virtual account number that payouts are sent FROM -- a separate product from
# regular Razorpay Payments, needs RazorpayX enabled on the same account. A restaurant's own bank
# details (collected via /restaurant/me/bank-account, admin-verified before any payout will use
# them) are looked up per-payout, not configured here.
# RAZORPAYX_ACCOUNT_NUMBER=

# Uploaded files (restaurant logos/documents, product images, customer profile photos) default to
# local disk (common/storage/local-disk-storage.gateway.ts) when these are unset -- zero setup for
# local dev, but files vanish on any host with ephemeral disk. Set S3_ENDPOINT (and the other
# three below) to switch to any S3-compatible object store instead
# (common/storage/s3-compatible-storage.gateway.ts) -- files then survive restarts/redeploys.
# Backblaze B2 is what this app's own dev deployment actually uses -- its free tier (10GB storage)
# needs no card at all, unlike Cloudflare R2 (also supported here, just needs a card on file even
# for its free tier). See DEPLOYMENT.md for exact bucket + key setup steps for either.
# S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# S3_REGION=us-west-004
# S3_BUCKET_NAME=dineflow-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
